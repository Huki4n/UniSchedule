#!/bin/sh
message=$(sed -e 's/\r$//' "$1" | head -n 1)

case "$message" in
  Merge\ *|Revert\ *|fixup!*|squash!*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?(!)?: .+'
if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  echo "Commit message must be a conventional commit: type(scope): subject"
  echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi

subject=$(printf '%s\n' "$message" | sed -E 's/^[a-z]+(\([^)]+\))?(!)?: //')
if [ "${#subject}" -gt 100 ]; then
  echo "Commit subject is longer than 100 characters"
  exit 1
fi