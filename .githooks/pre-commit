#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.cs$' || true)
if [ -z "$files" ]; then
  exit 0
fi

set --
while IFS= read -r file; do
  [ -z "$file" ] && continue
  dotnet csharpier format "$file"
  set -- "$@" --include "$file"
done <<EOF
$files
EOF

dotnet format UniSchedule.slnx analyzers --severity warn --no-restore "$@"
dotnet format UniSchedule.slnx analyzers --severity warn --verify-no-changes --no-restore "$@"

while IFS= read -r file; do
  [ -z "$file" ] && continue
  git add -- "$file"
done <<EOF
$files
EOF