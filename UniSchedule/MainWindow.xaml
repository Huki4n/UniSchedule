                        >
                            <Path
                                Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                Width="10"
                                Height="10"
                                Stretch="None"
                                Stroke="{StaticResource AppText}"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Button>
                    </Grid>
                    <ContentControl x:Name="EditorHost" />
                </DockPanel>
            </Grid>
        </Border>
        <Grid
            x:Name="ImportPanel"
            Visibility="Collapsed"
            Panel.ZIndex="3"
            Background="#B00A0A0A"
            AutomationProperties.AutomationId="ImportPanel"
        >
            <Border
                Width="420"
                Padding="24"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="1"
            >
                <StackPanel>
                    <TextBlock
                        Text="Импорт"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppText}"
                    />
                    <TextBlock
                        x:Name="ImportStatus"
                        Margin="0,12,0,16"
                        FontSize="16"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource AppMuted}"
                        AutomationProperties.AutomationId="ImportStatus"
                    />
                    <ProgressBar
                        Height="6"
                        IsIndeterminate="True"
                        BorderThickness="0"
                        Foreground="{StaticResource AppAccent}"
                        Background="{StaticResource AppCard}"
                    />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
