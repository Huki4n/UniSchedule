<Window
    x:Class="UniSchedule.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:UniSchedule.ViewModels"
    Title="UniSchedule"
    AutomationProperties.AutomationId="Main"
    Height="900"
    Width="1440"
    MinHeight="700"
    MinWidth="1100"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource AppBg}"
    PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
>
    <Grid>
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14"
            >
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Text="UniSchedule"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppText}"
                            />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock
                                    Text="Группа"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AppMuted}"
                                    FontSize="16"
                                    Margin="0,0,8,0"
                                />
                                <ComboBox
                                    x:Name="GroupBox"
                                    AutomationProperties.AutomationId="GroupBox"
                                    Width="200"
                                    Height="36"
                                    FontSize="16"
                                    IsEditable="True"
                                    IsTextSearchEnabled="False"
                                    StaysOpenOnEdit="True"
                                    SelectionChanged="GroupBox_OnSelectionChanged"
                                />
                                <TextBlock
                                    Text="Поиск"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AppMuted}"
                                    FontSize="16"
                                    Margin="16,0,8,0"
                                />
                                <TextBox
                                    x:Name="LessonSearchBox"
                                    AutomationProperties.AutomationId="LessonSearch"
                                    Width="280"
                                    Height="36"
                                    ToolTip="Предмет, преподаватель или домашка"
                                    TextChanged="LessonSearchBox_OnTextChanged"
                                />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                        >
                            <Button
                                Content="Импорт Excel"
                                AutomationProperties.AutomationId="Import"
                                Width="150"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="Import_Click"
                            />
                            <Button
                                Content="Добавить пару"
                                AutomationProperties.AutomationId="AddLesson"
                                Width="160"
                                Height="40"
                                Margin="0,0,8,0"
                                Click="Add_Click"
                                Style="{StaticResource AccentButton}"
                            />
                            <Button
                                Content="Настройки"
                                AutomationProperties.AutomationId="Settings"
                                Width="130"
                                Height="40"
                                Click="Settings_Click"
                            />
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        x:Name="ElectiveHost"
                        Orientation="Horizontal"
                        Margin="0,10,0,0"
                        Visibility="Collapsed"
                    >
                        <TextBlock
                            Text="Курс по выбору"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AppMuted}"
                            FontSize="16"
                            Margin="0,0,8,0"
                        />
                        <Grid Width="360" VerticalAlignment="Center">
                            <ToggleButton
                                x:Name="ElectiveBox"
                                AutomationProperties.AutomationId="ElectiveBox"
                                Height="36"
                                Focusable="False"
                                Template="{StaticResource ComboBoxToggleButton}"
                            />
                            <TextBlock
                                x:Name="ElectiveSummary"
                                Margin="12,0,32,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                TextTrimming="CharacterEllipsis"
                                IsHitTestVisible="False"
                            />
                            <Popup
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=ElectiveBox}"
                                AllowsTransparency="True"
                                PopupAnimation="Fade"
                                StaysOpen="False"
                                IsOpen="{Binding IsChecked, ElementName=ElectiveBox, Mode=TwoWay}"
                            >
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    Background="{StaticResource AppCard}"
                                    BorderBrush="{StaticResource AppBorder}"
                                    MinWidth="{Binding ActualWidth, ElementName=ElectiveBox}"
                                >
                                    <StackPanel x:Name="ElectiveList" />
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        x:Name="NextLessonLabel"
                        AutomationProperties.AutomationId="NextLesson"
                        Margin="0,8,0,0"
                        Foreground="{StaticResource AppMuted}"
                        FontSize="15"
                        MouseLeftButtonUp="NextLesson_OnClick"
                    />
                </StackPanel>
            </Border>

            <TabControl
                x:Name="MainTabs"
                Margin="8,4,8,8"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
            >
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="Transparent">
                            <TabPanel
                                DockPanel.Dock="Top"
                                IsItemsHost="True"
                                Background="Transparent"
                                Margin="8,4,8,0"
                            />
                            <ContentPresenter ContentSource="SelectedContent" Margin="0,8,0,0" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        x:Name="Bd"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="14,8,16,8"
                                        Cursor="Hand"
                                        ClipToBounds="False"
                                    >
                                        <ContentPresenter
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"
                                        />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter
                                                TargetName="Bd"
                                                Property="BorderBrush"
                                                Value="{StaticResource AppAccent}"
                                            />
                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource AppText}"
                                            />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource AppMuted}"
                                            />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem x:Name="ScheduleTab" AutomationProperties.AutomationId="ScheduleTab">
                    <TabItem.Header>
                        <TextBlock Text="Расписание" Padding="0,0,2,0" />
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel
                            DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="10,0,10,8"
                        >
                            <Button
                                AutomationProperties.AutomationId="PrevWeek"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="PrevWeek_Click"
                            >
                                <Path
                                    Data="M 6 0 L 0 6 L 6 12"
                                    Width="8"
                                    Height="12"
                                    Stretch="Fill"
                                    Stroke="{StaticResource AppMuted}"
                                    StrokeThickness="1.6"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                            </Button>
                            <TextBlock
                                x:Name="WeekLabel"
                                AutomationProperties.AutomationId="WeekLabel"
                                VerticalAlignment="Center"
                                Margin="12,0"
                                MinWidth="200"
                                TextAlignment="Center"
                                Foreground="{StaticResource AppAccent}"
                                FontWeight="SemiBold"
                                FontSize="16"
                            />
                            <Button
                                AutomationProperties.AutomationId="NextWeek"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="NextWeek_Click"
                            >
                                <Path
                                    Data="M 0 0 L 6 6 L 0 12"
                                    Width="8"
                                    Height="12"
                                    Stretch="Fill"
                                    Stroke="{StaticResource AppMuted}"
                                    StrokeThickness="1.6"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                            </Button>
                            <Button
                                Content="Сегодня"
                                AutomationProperties.AutomationId="TodayWeek"
                                Height="36"
                                Width="110"
                                Padding="0"
                                Margin="12,0,0,0"
                                VerticalContentAlignment="Center"
                                Click="TodayWeek_Click"
                            />
                        </StackPanel>
                        <ScrollViewer
                            x:Name="BoardScroll"
                            Margin="10,0,10,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            SizeChanged="Board_OnSizeChanged"
                        >
                            <Grid>
                                <ItemsControl
                                    x:Name="DaysHost"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"
                                >
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding NarrowBoard, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="True"
                                                >
                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed"
                                                    />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DayColumnVm}">
                                            <Border
                                                Margin="3,0"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                MinHeight="220"
                                            >
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter
                                                            Property="Background"
                                                            Value="{StaticResource AppSurface}"
                                                        />
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AppBorder}"
                                                        />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsToday}"
                                                                Value="True"
                                                            >
                                                                <Setter
                                                                    Property="Background"
                                                                    Value="{StaticResource AppToday}"
                                                                />
                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource AppTodayBorder}"
                                                                />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding IsHighlighted}"
                                                                Value="True"
                                                            >
                                                                <Setter
                                                                    Property="Background"
                                                                    Value="{StaticResource AppToday}"
                                                                />
                                                                <Setter
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource AppAccent}"
                                                                />
                                                                <Setter
                                                                    Property="BorderThickness"
                                                                    Value="2"
                                                                />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    Text="{x:Static vm:ScheduleComposer.EmptyDayText}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppMuted}"
                                                    FontSize="15"
                                                >
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed"
                                                            />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding IsEmpty}"
                                                                    Value="True"
                                                                >
                                                                    <Setter
                                                                        Property="Visibility"
                                                                        Value="Visible"
                                                                    />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="RowsHost" VerticalAlignment="Top">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoardRowVm}">
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="ItemsPanel">
                                                            <Setter.Value>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="6" />
                                                                </ItemsPanelTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding NarrowBoard, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Value="True"
                                                            >
                                                                <Setter Property="ItemsPanel">
                                                                    <Setter.Value>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:BoardCellVm}">
                                                        <Border CornerRadius="10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="Transparent"
                                                                    />
                                                                    <Setter
                                                                        Property="BorderThickness"
                                                                        Value="0"
                                                                    />
                                                                    <Setter
                                                                        Property="Padding"
                                                                        Value="0"
                                                                    />
                                                                    <Setter
                                                                        Property="Margin"
                                                                        Value="0"
                                                                    />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding ShowTitle}"
                                                                            Value="True"
                                                                        >
                                                                            <Setter
                                                                                Property="Background"
                                                                                Value="{StaticResource AppSurface}"
                                                                            />
                                                                            <Setter
                                                                                Property="BorderBrush"
                                                                                Value="{StaticResource AppBorder}"
                                                                            />
                                                                            <Setter
                                                                                Property="BorderThickness"
                                                                                Value="1"
                                                                            />
                                                                            <Setter
                                                                                Property="Padding"
                                                                                Value="8,8,4,8"
                                                                            />
                                                                            <Setter
                                                                                Property="Margin"
                                                                                Value="0,0,0,8"
                                                                            />
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition
                                                                                    Binding="{Binding ShowTitle}"
                                                                                    Value="True"
                                                                                />
                                                                                <Condition
                                                                                    Binding="{Binding Day.IsToday}"
                                                                                    Value="True"
                                                                                />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter
                                                                                Property="Background"
                                                                                Value="{StaticResource AppToday}"
                                                                            />
                                                                            <Setter
                                                                                Property="BorderBrush"
                                                                                Value="{StaticResource AppTodayBorder}"
                                                                            />
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition
                                                                                    Binding="{Binding ShowTitle}"
                                                                                    Value="True"
                                                                                />
                                                                                <Condition
                                                                                    Binding="{Binding Day.IsHighlighted}"
                                                                                    Value="True"
                                                                                />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter
                                                                                Property="Background"
                                                                                Value="{StaticResource AppToday}"
                                                                            />
                                                                            <Setter
                                                                                Property="BorderBrush"
                                                                                Value="{StaticResource AppAccent}"
                                                                            />
                                                                            <Setter
                                                                                Property="BorderThickness"
                                                                                Value="2"
                                                                            />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel Margin="11,0,7,0">
                                                                <TextBlock
                                                                    DockPanel.Dock="Top"
                                                                    Text="{Binding Day.Title}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="16"
                                                                    Foreground="{StaticResource AppText}"
                                                                    Margin="0,10,4,8"
                                                                    TextWrapping="Wrap"
                                                                >
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter
                                                                                Property="Visibility"
                                                                                Value="Collapsed"
                                                                            />
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding IsHeader}"
                                                                                    Value="True"
                                                                                >
                                                                                    <Setter
                                                                                        Property="Visibility"
                                                                                        Value="Visible"
                                                                                    />
                                                                                </DataTrigger>
                                                                                <DataTrigger
                                                                                    Binding="{Binding ShowTitle}"
                                                                                    Value="True"
                                                                                >
                                                                                    <Setter
                                                                                        Property="Visibility"
                                                                                        Value="Visible"
                                                                                    />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock
                                                                    DockPanel.Dock="Top"
                                                                    Text="{x:Static vm:ScheduleComposer.EmptyDayText}"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,8,0,12"
                                                                    Foreground="{StaticResource AppMuted}"
                                                                    FontSize="15"
                                                                >
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter
                                                                                Property="Visibility"
                                                                                Value="Collapsed"
                                                                            />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition
                                                                                            Binding="{Binding ShowTitle}"
                                                                                            Value="True"
                                                                                        />
                                                                                        <Condition
                                                                                            Binding="{Binding Day.IsEmpty}"
                                                                                            Value="True"
                                                                                        />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter
                                                                                        Property="Visibility"
                                                                                        Value="Visible"
                                                                                    />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl
                                                                    ItemsSource="{Binding Cards}"
                                                                    VerticalAlignment="Top"
                                                                >
                                                                    <ItemsControl.Style>
                                                                        <Style TargetType="ItemsControl">
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding IsHeader}"
                                                                                    Value="True"
                                                                                >
                                                                                    <Setter
                                                                                        Property="Visibility"
                                                                                        Value="Collapsed"
                                                                                    />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ItemsControl.Style>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:LessonCardVm}">
                                                                            <Border
                                                                                Margin="0,0,4,6"
                                                                                Padding="12,10"
                                                                                CornerRadius="10"
                                                                                Cursor="Hand"
                                                                                VerticalAlignment="Top"
                                                                                MouseLeftButtonUp="LessonCard_OnClick"
                                                                                Opacity="{Binding IsDimmed, Converter={StaticResource DimConverter}}"
                                                                            >
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="{StaticResource AppCard}"
                                                                                        />
                                                                                        <Setter
                                                                                            Property="BorderBrush"
                                                                                            Value="Transparent"
                                                                                        />
                                                                                        <Setter
                                                                                            Property="BorderThickness"
                                                                                            Value="1"
                                                                                        />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding IsOverlap}"
                                                                                                Value="True"
                                                                                            >
                                                                                                <Setter
                                                                                                    Property="BorderBrush"
                                                                                                    Value="{StaticResource AppWarning}"
                                                                                                />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding IsCurrent}"
                                                                                                Value="True"
                                                                                            >
                                                                                                <Setter
                                                                                                    Property="BorderBrush"
                                                                                                    Value="{StaticResource AppAccent}"
                                                                                                />
                                                                                                <Setter
                                                                                                    Property="BorderThickness"
                                                                                                    Value="2"
                                                                                                />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding IsHighlighted}"
                                                                                                Value="True"
                                                                                            >
                                                                                                <Setter
                                                                                                    Property="BorderBrush"
                                                                                                    Value="{StaticResource AppAccent}"
                                                                                                />
                                                                                                <Setter
                                                                                                    Property="BorderThickness"
                                                                                                    Value="2"
                                                                                                />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <DockPanel>
                                                                                    <Border
                                                                                        DockPanel.Dock="Left"
                                                                                        Width="4"
                                                                                        CornerRadius="2"
                                                                                        Margin="0,0,10,0"
                                                                                        Background="{Binding Accent, Converter={StaticResource HexBrushConverter}}"
                                                                                    />
                                                                                    <StackPanel>
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel
                                                                                                Orientation="Horizontal"
                                                                                                VerticalAlignment="Center"
                                                                                            >
                                                                                                <TextBlock
                                                                                                    Text="{Binding StartText}"
                                                                                                    FontWeight="SemiBold"
                                                                                                    FontSize="14"
                                                                                                    Foreground="{StaticResource AppText}"
                                                                                                />
                                                                                                <TextBlock
                                                                                                    Text="–"
                                                                                                    Margin="4,0"
                                                                                                    FontSize="13"
                                                                                                    Foreground="{StaticResource AppMuted}"
                                                                                                />
                                                                                                <TextBlock
                                                                                                    Text="{Binding EndText}"
                                                                                                    FontSize="13"
                                                                                                    Foreground="{StaticResource AppMuted}"
                                                                                                />
                                                                                            </StackPanel>
                                                                                            <Border
                                                                                                Grid.Column="1"
                                                                                                CornerRadius="6"
                                                                                                Padding="8,2"
                                                                                                VerticalAlignment="Center"
                                                                                                Margin="8,0,0,0"
                                                                                                BorderBrush="{StaticResource AppBorder}"
                                                                                                BorderThickness="1"
                                                                                            >
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter
                                                                                                            Property="Visibility"
                                                                                                            Value="Collapsed"
                                                                                                        />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding ShowOnline}"
                                                                                                                Value="True"
                                                                                                            >
                                                                                                                <Setter
                                                                                                                    Property="Visibility"
                                                                                                                    Value="Visible"
                                                                                                                />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock
                                                                                                    Text="Онлайн"
                                                                                                    FontSize="12"
                                                                                                    Foreground="{StaticResource AppText}"
                                                                                                />
                                                                                            </Border>
                                                                                        </Grid>
                                                                                        <TextBlock
                                                                                            Text="{Binding Subject}"
                                                                                            FontWeight="SemiBold"
                                                                                            FontSize="16"
                                                                                            Margin="0,4,0,0"
                                                                                            TextWrapping="Wrap"
                                                                                            Foreground="{StaticResource AppText}"
                                                                                        />
                                                                                        <TextBlock
                                                                                            Text="{Binding Detail}"
                                                                                            FontSize="13"
                                                                                            Margin="0,4,0,0"
                                                                                            Foreground="{StaticResource AppMuted}"
                                                                                            TextWrapping="Wrap"
                                                                                        >
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger
                                                                                                            Binding="{Binding Detail}"
                                                                                                            Value=""
                                                                                                        >
                                                                                                            <Setter
                                                                                                                Property="Visibility"
                                                                                                                Value="Collapsed"
                                                                                                            />
                                                                                                            <Setter
                                                                                                                Property="Margin"
                                                                                                                Value="0"
