<Window x:Class="UniSchedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniSchedule.ViewModels"
        Title="Расписание"
        AutomationProperties.AutomationId="Main"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Расписание ИТИС" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AppText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Группа" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppMuted}" FontSize="16" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GroupBox" AutomationProperties.AutomationId="GroupBox" Width="200" Height="36" FontSize="16"
                                  IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                  SelectionChanged="GroupBox_OnSelectionChanged"/>
                        <TextBlock Text="Поиск" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppMuted}" FontSize="16" Margin="16,0,8,0"/>
                        <TextBox x:Name="LessonSearchBox" AutomationProperties.AutomationId="LessonSearch" Width="240" Height="36"
                                 ToolTip="Предмет или преподаватель"
                                 TextChanged="LessonSearchBox_OnTextChanged"/>
                        <TextBlock x:Name="WeekLabel" AutomationProperties.AutomationId="WeekLabel" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource AppAccent}" FontWeight="SemiBold" FontSize="16"/>
                    </StackPanel>
                    <TextBlock x:Name="NextLessonLabel" AutomationProperties.AutomationId="NextLesson" Margin="0,8,0,0"
                               Foreground="{StaticResource AppMuted}" FontSize="15"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Импорт Excel" AutomationProperties.AutomationId="Import" Width="150" Height="40" Margin="0,0,8,0" Click="Import_Click"/>
                    <Button Content="Добавить пару" AutomationProperties.AutomationId="AddLesson" Width="160" Height="40" Margin="0,0,8,0" Click="Add_Click"
                            Style="{StaticResource AccentButton}"/>
                    <Button Content="Настройки" AutomationProperties.AutomationId="Settings" Width="130" Height="40" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl x:Name="DaysHost" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DayColumnVm}">
                    <Border Margin="3,0" CornerRadius="10" BorderThickness="1" Padding="8,8,4,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppSurface}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AppToday}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AppTodayBorder}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="17" Foreground="{StaticResource AppText}" Margin="4,0,4,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding Lessons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LessonCardVm}">
                                            <Border Margin="0,0,4,6" Padding="10,9" CornerRadius="8" Cursor="Hand"
                                                    Background="{StaticResource AppCard}"
                                                    MouseLeftButtonUp="LessonCard_OnClick"
                                                    Opacity="{Binding IsDimmed, Converter={StaticResource DimConverter}}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,0,8,0"
                                                            Background="{Binding Accent, Converter={StaticResource HexBrushConverter}}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TimeText}" FontSize="13"
                                                                   Foreground="{StaticResource AppMuted}" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="15"
                                                                   TextWrapping="Wrap" Foreground="{StaticResource AppText}" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Place}" Foreground="#D1D5DB" FontSize="14" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource AppMuted}"
                                                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding Badge}" Foreground="#C4B5FD" FontSize="13"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Изменить" Click="EditMenu_Click"/>
                                                        <MenuItem Header="Удалить" Click="DeleteMenu_Click"/>
                                                        <MenuItem Header="Открыть ссылку" Click="OpenLinkMenu_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
