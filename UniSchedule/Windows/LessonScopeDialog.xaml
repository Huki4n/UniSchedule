<Window x:Class="UniSchedule.Windows.LessonScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Применить изменения"
        AutomationProperties.AutomationId="LessonScopeDialog"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource AppSurface}"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,20"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Такое название есть у других пар" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource AppText}" TextWrapping="Wrap"/>
            <TextBlock Text="К каким парам применить сохранение?" FontSize="15" Margin="0,10,0,16"
                       Foreground="{StaticResource AppMuted}" TextWrapping="Wrap"/>
            <Button AutomationProperties.AutomationId="ScopeOnlyThis" Content="Только эту пару"
                    Height="40" Margin="0,0,0,8" IsDefault="True" Click="OnlyThis_Click"/>
            <Button AutomationProperties.AutomationId="ScopeFollowing" Content="Эту и следующие"
                    Height="40" Margin="0,0,0,8" Click="Following_Click"/>
            <Button AutomationProperties.AutomationId="ScopeAll" Content="Все пары с этим названием"
                    Height="40" Margin="0,0,0,8" Click="All_Click"/>
            <Button AutomationProperties.AutomationId="ScopeCancel" Content="Отмена"
                    Height="40" IsCancel="True" HorizontalAlignment="Right" Width="120" Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</Window>
