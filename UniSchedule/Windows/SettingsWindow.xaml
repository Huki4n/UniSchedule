<Window
    x:Class="UniSchedule.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки"
    AutomationProperties.AutomationId="SettingsWindow"
    Width="500"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="False"
    Background="{StaticResource AppBg}"
>
    <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
        <DockPanel Margin="20">
            <Grid
                DockPanel.Dock="Top"
                Margin="0,0,0,16"
                MouseLeftButtonDown="Title_OnMouseLeftButtonDown"
            >
                <TextBlock
                    Text="Настройки"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AppText}"
                />
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="Cancel_Click"
                >
                    <Path
                        Data="M 0 0 L 10 10 M 10 0 L 0 10"
                        Width="10"
                        Height="10"
                        Stretch="None"
                        Stroke="{StaticResource AppText}"
                        StrokeThickness="1.6"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    />
                </Button>
            </Grid>
            <StackPanel
                DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
            >
                <Button
                    AutomationProperties.AutomationId="CancelSettings"
                    Content="Отмена"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"
                />
                <Button
                    AutomationProperties.AutomationId="SaveSettings"
                    Content="Сохранить"
                    Width="120"
                    Height="36"
                    IsDefault="True"
                    Click="Save_Click"
                    Style="{StaticResource AccentButton}"
                />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Группа" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GroupBox" IsEditable="True" Height="36" />
                    <Button
                        Grid.Column="1"
                        Content="Добавить"
                        MinWidth="120"
                        Height="36"
                        Padding="16,0"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="AddGroup_Click"
                    />
                </Grid>

                <TextBlock
                    Text="Начало семестра"
                    Style="{StaticResource LabelText}"
                    Margin="0,0,0,6"
                />
                <DatePicker x:Name="SemesterPicker" Height="36" Margin="0,0,0,14" />

                <Button
                    Content="Уведомления"
                    AutomationProperties.AutomationId="OpenNotifications"
                    Height="36"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"
                    Click="OpenNotifications_Click"
                />
                <CheckBox
                    x:Name="TrayBox"
                    AutomationProperties.AutomationId="MinimizeToTray"
                    Content="Сворачивать в трей при закрытии"
                    Margin="0,0,0,12"
                />
                <CheckBox
                    x:Name="AutostartBox"
                    Content="Запускать вместе с Windows"
                    Margin="0,0,0,16"
                />
                <WrapPanel Margin="0,12,0,0">
                    <Button
                        AutomationProperties.AutomationId="ClearStoredData"
                        Content="Очистить данные"
                        Height="36"
                        Margin="0,0,8,8"
                        Click="Clear_Click"
                    />
                    <Button
                        AutomationProperties.AutomationId="CopyDatabase"
                        Content="Сохранить копию"
                        Height="36"
                        Margin="0,0,8,8"
                        Click="Copy_Click"
                    />
                    <Button
                        AutomationProperties.AutomationId="RestoreDatabase"
                        Content="Открыть копию"
                        Height="36"
                        Margin="0,0,8,8"
                        Click="Restore_Click"
                    />
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
