<UserControl x:Class="UniSchedule.Windows.HomeworkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="HomeworkEditor"
        Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button AutomationProperties.AutomationId="OpenHomeworkSchedule" Content="К расписанию" Height="36" Padding="14,0"
                    HorizontalAlignment="Left" Click="OpenSchedule_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteHomework" Content="Удалить" Width="110" Height="36" Margin="0,0,8,0"
                    Click="Delete_Click" Visibility="Collapsed"/>
            <Button AutomationProperties.AutomationId="CancelHomework" Content="Отмена" Width="110" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button AutomationProperties.AutomationId="SaveHomework" Content="Сохранить" Width="120" Height="36" Click="Save_Click"
                    Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Style="{StaticResource DialogScrollViewer}">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Задание" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Пара" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="LessonBox" AutomationProperties.AutomationId="HomeworkLesson" Margin="0,0,0,12"
                          SelectionChanged="LessonBox_SelectionChanged"/>
                <TextBlock Text="Время" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SlotBox" AutomationProperties.AutomationId="HomeworkSlot" Margin="0,0,0,12"/>
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TitleBox" AutomationProperties.AutomationId="HomeworkTitle" Margin="0,0,0,12"/>
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" AutomationProperties.AutomationId="HomeworkDescription"
                         Height="96" MinHeight="96" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                <TextBlock Text="Дедлайн" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DeadlineBox" AutomationProperties.AutomationId="HomeworkDeadline" Margin="0,0,0,12"/>
                <CheckBox x:Name="DoneBox" AutomationProperties.AutomationId="HomeworkDone" Content="Сделано" Margin="0,4,0,18"/>

                <TextBlock Text="Ссылки" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Ссылка на задание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UrlBox" AutomationProperties.AutomationId="HomeworkUrl" Margin="0,0,0,12"/>
                <TextBlock Text="Дополнительная ссылка" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ExtraUrlBox" AutomationProperties.AutomationId="HomeworkExtraUrl" Margin="0,0,0,18"/>

                <TextBlock Text="Комментарии" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="CommentList"/>
                <TextBlock x:Name="CommentLocked" Text="Комментарии можно добавить после сохранения."
                           Foreground="{StaticResource AppMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <Border x:Name="CommentComposer" Margin="0,4,0,0" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{StaticResource AppBorder}" Background="{StaticResource AppCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="CommentBox" AutomationProperties.AutomationId="HomeworkComment"
                                     Background="Transparent" BorderThickness="0"
                                     GotFocus="CommentBox_GotFocus" LostFocus="CommentBox_LostFocus"
                                     TextChanged="CommentBox_TextChanged"/>
                            <TextBlock x:Name="CommentPlaceholder" Text="Комментарий" IsHitTestVisible="False"
                                       Margin="12,0,12,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AppMuted}"/>
                        </Grid>
                        <StackPanel x:Name="CommentActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="8,4,8,8" Visibility="Collapsed">
                            <Button Content="Отмена" Height="36" MinWidth="96" Padding="12,0" Margin="0,0,8,0" Click="CollapseComment_Click"/>
                            <Button AutomationProperties.AutomationId="AddHomeworkComment" Content="Комментарий"
                                    Height="36" MinWidth="132" Padding="12,0" Click="AddComment_Click" Style="{StaticResource AccentButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
