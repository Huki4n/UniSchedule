<Window x:Class="UniSchedule.Windows.LessonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пара"
        AutomationProperties.AutomationId="LessonEditor"
        Height="720" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteLesson" Content="Удалить" Width="110" Height="36" Margin="0,0,8,0"
                    Click="Delete_Click" Visibility="Collapsed"/>
            <Button AutomationProperties.AutomationId="CancelLesson" Content="Отмена" Width="110" Height="36" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button AutomationProperties.AutomationId="SaveLesson" Content="Сохранить" Width="120" Height="36" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>

        <ScrollViewer Style="{StaticResource DialogScrollViewer}">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="День" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="DayBox" AutomationProperties.AutomationId="LessonDay" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Text="Начало" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="StartBox" AutomationProperties.AutomationId="LessonStart" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="Конец" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="EndBox" AutomationProperties.AutomationId="LessonEnd" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Text="Предмет" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="SubjectBox" AutomationProperties.AutomationId="LessonSubject" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Text="Тип" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="TypeBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Text="Преподаватель" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="TeacherBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Text="Кабинет" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="RoomBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="7" Text="Ссылка на пару" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="MeetingBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="8" Text="Ссылка ЦОР" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="LmsBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="9" Text="Недели" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="ParityBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="10" Text="С недели" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="WeekFromBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="11" Text="По неделю" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="WeekToBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="12" Text="Заметки" VerticalAlignment="Top" Margin="0,6,0,0" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="NotesBox" Grid.Row="12" Grid.Column="1" Height="72" TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
