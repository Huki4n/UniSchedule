<UserControl x:Class="UniSchedule.Windows.LessonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="LessonEditor"
        Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteLesson" Content="Удалить" Width="110" Height="36" Margin="0,0,8,0"
                    Click="Delete_Click" Visibility="Collapsed"/>
            <Button AutomationProperties.AutomationId="CancelLesson" Content="Отмена" Width="110" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button AutomationProperties.AutomationId="SaveLesson" Content="Сохранить" Width="120" Height="36" Click="Save_Click"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>

        <ScrollViewer Style="{StaticResource DialogScrollViewer}">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Занятие" Style="{StaticResource SectionTitle}"/>
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="RollbackSubjectButton" DockPanel.Dock="Right" Visibility="Collapsed"
                            AutomationProperties.AutomationId="RollbackSubject" Height="28" Padding="10,0" Margin="12,0,0,0"
                            Click="RollbackSubject_Click"/>
                    <TextBlock Text="Предмет" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="SubjectBox" AutomationProperties.AutomationId="LessonSubject" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Тип" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TypeBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Преподаватель" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TeacherBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Время" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="День" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DayBox" AutomationProperties.AutomationId="LessonDay"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Начало" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="StartBox" AutomationProperties.AutomationId="LessonStart"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Конец" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EndBox" AutomationProperties.AutomationId="LessonEnd"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Место и ссылки" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Кабинет" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RoomBox" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ссылка на пару" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MeetingBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ссылка ЦОР" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="LmsBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Недели семестра" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Какие недели" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ParityBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="С недели" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeekFromBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="По неделю" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeekToBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Заметки" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="NotesBox" Height="88" MinHeight="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                <StackPanel x:Name="HomeworkPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Text="Домашки" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="HomeworkList"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
