<UserControl
    x:Class="UniSchedule.Windows.LessonEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="LessonEditor"
    Background="Transparent"
>
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppCard}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="20,16,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button
                x:Name="DeleteButton"
                DockPanel.Dock="Left"
                AutomationProperties.AutomationId="DeleteLesson"
                Content="Удалить"
                Width="110"
                Height="36"
                Click="Delete_Click"
                Visibility="Collapsed"
            />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    AutomationProperties.AutomationId="CancelLesson"
                    Content="Отмена"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                />
                <Button
                    AutomationProperties.AutomationId="SaveLesson"
                    Content="Сохранить"
                    Width="120"
                    Height="36"
                    Click="Save_Click"
                    Style="{StaticResource AccentButton}"
                />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Style="{StaticResource DialogScrollViewer}">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Занятие" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,4">
                            <Button
                                x:Name="RollbackSubjectButton"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="RollbackSubject"
                                Height="28"
                                Padding="10,0"
                                Margin="12,0,0,0"
                                Click="RollbackSubject_Click"
                            />
                            <TextBlock
                                Text="Предмет"
                                Style="{StaticResource FieldLabel}"
                                Margin="0"
                                VerticalAlignment="Center"
                            />
                        </DockPanel>
                        <TextBox
                            x:Name="SubjectBox"
                            AutomationProperties.AutomationId="LessonSubject"
                            Margin="0,0,0,12"
                        />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тип" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="TypeBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Text="Преподаватель"
                                    Style="{StaticResource FieldLabel}"
                                />
                                <TextBox x:Name="TeacherBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Время" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="День" Style="{StaticResource FieldLabel}" />
                                <ComboBox
                                    x:Name="DayBox"
                                    AutomationProperties.AutomationId="LessonDay"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Начало" Style="{StaticResource FieldLabel}" />
                                <TextBox
                                    x:Name="StartBox"
                                    AutomationProperties.AutomationId="LessonStart"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Конец" Style="{StaticResource FieldLabel}" />
                                <TextBox
                                    x:Name="EndBox"
                                    AutomationProperties.AutomationId="LessonEnd"
                                />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Место и ссылки" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Кабинет" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RoomBox" Margin="0,0,0,12" />
                        <TextBlock Text="Ссылка на пару" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MeetingBox" Margin="0,0,0,12" />
                        <TextBlock Text="Ссылка ЦОР" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LmsBox" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Недели семестра" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Какие недели" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ParityBox" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="С недели" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="WeekFromBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="По неделю" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="WeekToBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Заметки" Style="{StaticResource SectionTitle}" />
                        <TextBox
                            x:Name="NotesBox"
                            Height="88"
                            MinHeight="88"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                        />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="HomeworkPanel"
                    Style="{StaticResource Section}"
                    Visibility="Collapsed"
                >
                    <StackPanel>
                        <TextBlock Text="Домашки" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="HomeworkList" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
