<Window x:Class="UniSchedule.Windows.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание"
        AutomationProperties.AutomationId="AppDialog"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource AppSurface}"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,20"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="DialogCancel" Content="Отмена" MinWidth="110" Height="38" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" AutomationProperties.AutomationId="DialogOk" Content="OK" MinWidth="120" Height="38" IsDefault="True" Click="Ok_Click"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="DialogTitle" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource AppText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" FontSize="15" Margin="0,10,0,0"
                           Foreground="{StaticResource AppMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
