<Window
    x:Class="UniSchedule.Windows.NotificationSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Уведомления"
    AutomationProperties.AutomationId="NotificationSettingsWindow"
    Width="560"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="False"
    Background="{StaticResource AppBg}"
>
    <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="1">
        <DockPanel Margin="20">
            <Grid
                DockPanel.Dock="Top"
                Margin="0,0,0,16"
                MouseLeftButtonDown="Title_OnMouseLeftButtonDown"
            >
                <TextBlock
                    Text="Уведомления"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AppText}"
                />
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="Cancel_Click"
                >
                    <Path
                        Data="M 0 0 L 10 10 M 10 0 L 0 10"
                        Width="10"
                        Height="10"
                        Stretch="None"
                        Stroke="{StaticResource AppText}"
                        StrokeThickness="1.6"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    />
                </Button>
            </Grid>
            <StackPanel
                DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
            >
                <Button
                    AutomationProperties.AutomationId="CancelNotifications"
                    Content="Отмена"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"
                />
                <Button
                    AutomationProperties.AutomationId="SaveNotifications"
                    Content="Готово"
                    Width="120"
                    Height="36"
                    IsDefault="True"
                    Click="Save_Click"
                    Style="{StaticResource AccentButton}"
                />
            </StackPanel>

            <StackPanel>
                <TextBlock
                    Text="Напоминание, мин."
                    Style="{StaticResource LabelText}"
                    Margin="0,0,0,6"
                />
                <WrapPanel x:Name="ReminderPresets" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ReminderBox"
                        AutomationProperties.AutomationId="ReminderMinutes"
                        Height="36"
                        PreviewKeyDown="ReminderBox_OnPreviewKeyDown"
                    />
                    <Button
                        Grid.Column="1"
                        Content="Добавить"
                        AutomationProperties.AutomationId="AddReminder"
                        MinWidth="120"
                        Height="36"
                        Padding="16,0"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="AddReminder_Click"
                    />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <ComboBox
                            x:Name="ReminderList"
                            Height="36"
                            AutomationProperties.AutomationId="ReminderList"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=за {0} мин.}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border
                            IsHitTestVisible="False"
                            Margin="12,0,32,0"
                            Background="{StaticResource AppCard}"
                        >
                            <TextBlock
                                x:Name="ReminderSummary"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AppText}"
                            />
                        </Border>
                    </Grid>
                    <Button
                        x:Name="ReminderRemoveButton"
                        Grid.Column="1"
                        Content="Удалить"
                        AutomationProperties.AutomationId="ReminderRemove"
                        MinWidth="120"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="RemoveReminder_Click"
                    />
                </Grid>

                <TextBlock
                    Text="Напоминание о сроке сдачи домашек"
                    Style="{StaticResource LabelText}"
                    Margin="0,0,0,6"
                />
                <WrapPanel x:Name="HomeworkReminderPresets" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="HomeworkReminderBox"
                        AutomationProperties.AutomationId="HomeworkReminderMinutes"
                        Height="36"
                        PreviewKeyDown="HomeworkReminderBox_OnPreviewKeyDown"
                    />
                    <Button
                        Grid.Column="1"
                        Content="Добавить"
                        AutomationProperties.AutomationId="AddHomeworkReminder"
                        MinWidth="120"
                        Height="36"
                        Padding="16,0"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="AddHomeworkReminder_Click"
                    />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <ComboBox
                            x:Name="HomeworkReminderList"
                            Height="36"
                            AutomationProperties.AutomationId="HomeworkReminderList"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource HomeworkReminderLabelConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border
                            IsHitTestVisible="False"
                            Margin="12,0,32,0"
                            Background="{StaticResource AppCard}"
                        >
                            <TextBlock
                                x:Name="HomeworkReminderSummary"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AppText}"
                            />
                        </Border>
                    </Grid>
                    <Button
                        x:Name="HomeworkReminderRemoveButton"
                        Grid.Column="1"
                        Content="Удалить"
                        AutomationProperties.AutomationId="HomeworkReminderRemove"
                        MinWidth="120"
                        Height="36"
                        Margin="8,0,0,0"
                        Click="RemoveHomeworkReminder_Click"
                    />
                </Grid>

                <CheckBox x:Name="NotifyBox" Content="Включить уведомления" Margin="0,0,0,12" />
                <Button
                    Content="Тест уведомления"
                    Height="36"
                    HorizontalAlignment="Left"
                    Click="TestNotify_Click"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
