<Application x:Class="UniSchedule.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UniSchedule.Converters"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniSchedule;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UniSchedule;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UniSchedule;component/Themes/Calendar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:DimConverter x:Key="DimConverter"/>
            <conv:HexBrushConverter x:Key="HexBrushConverter"/>
            <conv:HomeworkReminderLabelConverter x:Key="HomeworkReminderLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
